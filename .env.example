# Copy this file to .env and fill in real values. .env is gitignored.

# --- Transcription: Deepgram (Phase 2) ---
DEEPGRAM_API_KEY=
# Optional. Defaults to nova-3.
DEEPGRAM_MODEL=nova-3

# --- LLM: persona analysis + prompt generation (Phases 3-4) ---
# Any OpenAI-compatible provider works; only these three lines change.
#
#   xAI (Grok)   LLM_BASE_URL=https://api.x.ai/v1
#                LLM_MODEL=grok-4-fast
#   OpenAI       LLM_BASE_URL=https://api.openai.com/v1
#                LLM_MODEL=gpt-4o
#   Groq (free)  LLM_BASE_URL=https://api.groq.com/openai/v1
#                LLM_MODEL=llama-3.3-70b-versatile
#   Gemini(free) LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                LLM_MODEL=gemini-2.5-flash  (3.7-flash has a 20 req/day free cap)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# Optional. Only the voice pass sends audio, and not every text model reads it.
# Defaults to LLM_MODEL, which is right on Gemini. On OpenAI set:
#   LLM_AUDIO_MODEL=gpt-audio
LLM_AUDIO_MODEL=

# --- Voice pacing (optional) ---
# The measured words-per-minute of the source speaker is divided by these to
# get the TTS speed multiplier. Raise a baseline to make that voice SLOWER.
# Male is higher because Azure's male neural voices already read faster at 1.0x.
VOICE_BASELINE_WPM_MALE=200
VOICE_BASELINE_WPM_FEMALE=155
VOICE_MAX_SPEED_MALE=1.15
VOICE_MAX_SPEED_FEMALE=1.3
# Non-English locales get their own baselines, because the measured number is a
# WORD COUNT and languages differ in how many words fit in a minute. Dividing a
# Hindi count by an English baseline made a fast speaker come out at 0.92x.
# Override any locale by name, e.g.:
# VOICE_BASELINE_WPM_HI_IN_MALE=155
# VOICE_BASELINE_WPM_HI_IN_FEMALE=145
# VOICE_BASELINE_WPM_TA_IN_MALE=150

# --- Vapi (Phase 6) ---
VAPI_API_KEY=
# The Vapi number to dial OUT from. Find it with:
#   curl https://api.vapi.ai/phone-number -H "Authorization: Bearer $VAPI_API_KEY"
# Without it the code falls back to importing a Twilio number, or to the first
# number on the account - fine for one number, ambiguous the moment there are two.
VAPI_PHONE_NUMBER_ID=

# The model that drives the live call. Defaults to gpt-5.6-luna: fast first
# token, and holds a long persona instruction list better than gpt-4o-mini.
VAPI_MODEL=gpt-5.6-luna

# The gpt-5 family reasons before answering, and on a call that thinking time is
# dead air. Only sent for gpt-5* models, which are the only ones that accept it.
VAPI_REASONING_EFFORT=minimal

# How long Vapi waits after the transcriber stops before calling the model.
# The no-punctuation default is 1.5s, and Deepgram's Hindi models punctuate
# rarely - so on a Hindi call that slow path is taken on nearly every turn.
# This is usually the largest single cause of "the agent reacts late".
VAPI_ENDPOINT_NO_PUNCTUATION=0.6
VAPI_ENDPOINT_PUNCTUATION=0.1
VAPI_ENDPOINT_NUMBER=0.4

# --- Twilio (Phase 6) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Your own phone, for the outbound test call
TEST_PHONE_NUMBER=

# --- Indian language detection + STT (Sarvam AI) ---
# Enables the input-audio detection layer to identify Hindi, Hinglish and the
# regional languages, and to transcribe them. Without it, Indian-language
# recordings fall back to Deepgram, which returns confident nonsense for them.
# SERVAM_API_KEY is accepted as an alias for backwards compatibility.
SARVAM_API_KEY=
# Deepgram model for languages nova-3 does not cover. nova-3 now handles Hindi
# and most Indian languages; hi-Latn (romanised Hindi, i.e. Hinglish as people
# write it) is the one that still lives only on nova-2.
DEEPGRAM_MULTILINGUAL_MODEL=nova-2

# The realtime model the live agent listens with. nova-3 is both more accurate
# and lower latency than nova-2 - and accuracy IS latency here, because Vapi
# waits 0.1s to reply after a punctuated transcript and 1.5s after an
# unpunctuated one.
VAPI_TRANSCRIBER_MODEL=nova-3

# Deepgram's own silence timeout, in ms, before it emits a transcript. 10 is the
# low-latency default; 300 is the documented fix if one-word answers go missing.
VAPI_DEEPGRAM_ENDPOINTING=10

# --- TTS provider (optional) ---
# azure (default) covers every language with stable voice ids, and is the most
# robotic. cartesia sounds markedly more human and reaches first audio faster.
# Cartesia voice ids are account-scoped UUIDs, so each one must be named here;
# list yours at https://api.cartesia.ai/voices.
VAPI_TTS_PROVIDER=azure
CARTESIA_MODEL=sonic-2
# CARTESIA_VOICE_HI_IN_MALE=
# CARTESIA_VOICE_HI_IN_FEMALE=
# CARTESIA_VOICE_EN_IN_MALE=
# CARTESIA_VOICE_EN_IN_FEMALE=
# CARTESIA_VOICE_EN_US_MALE=
# CARTESIA_VOICE_EN_US_FEMALE=

# Floor on the TTS speed multiplier. Below ~0.9x the audio is stretched rather
# than spoken slowly, which is audible as "robot".
VOICE_MIN_SPEED=0.9
